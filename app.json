{
  "expo": {
    "name": "Le Scribe du Royaume",
    "slug": "scribe-du-royaume",
    "version": "1.0.0",
    "platforms": ["ios", "web"],
    "orientation": "portrait",
    "icon": "./assets/images/app/icon.png",
    "scheme": "scribe-du-royaume",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#17142B",
    "web": {
      "output": "static",
      "favicon": "./assets/images/app/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#17142B",
          "image": "./assets/images/app/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
